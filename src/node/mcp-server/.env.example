# Optional: tenant to authenticate against. If unset, DefaultAzureCredential
# uses the credential's default tenant (e.g., the one from `az login`).
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional: scope used for Microsoft Graph calls (whoami, list-my-groups).
# GRAPH_SCOPE=https://graph.microsoft.com/.default

# Optional: default scope used by the `token-info` tool when no scope arg is given.
# DEFAULT_TOKEN_SCOPE=https://management.azure.com/.default
