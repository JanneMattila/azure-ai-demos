# Optional: tenant to authenticate against. If unset, DefaultAzureCredential
# uses the credential's default tenant (e.g., the one from `az login`).
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional: scope used for Microsoft Graph calls (whoami, list-my-groups).
# GRAPH_SCOPE=https://graph.microsoft.com/.default

# Optional: default scope used by the `token-info` tool when no scope arg is given.
# DEFAULT_TOKEN_SCOPE=https://management.azure.com/.default

# Optional: skip DefaultAzureCredential entirely and always use the
# interactive browser sign-in flow. Useful for testing the
# "only VS Code installed" experience.
# FORCE_INTERACTIVE_AUTH=true

# Optional: client ID for InteractiveBrowserCredential. Defaults to the
# Azure CLI public client id, which works in most tenants without your
# own app registration.
# INTERACTIVE_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46
